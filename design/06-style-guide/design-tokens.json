{
  "meta": {
    "name": "AI-DLC Design Pipeline Tokens",
    "version": "1.0.0",
    "description": "Baseline semantic tokens for repo-native design pipeline artifacts and product UI specifications."
  },
  "color": {
    "background": {
      "page": "#ffffff",
      "surface": "#f8fafc",
      "elevated": "#ffffff",
      "inverse": "#0f172a"
    },
    "text": {
      "primary": "#0f172a",
      "secondary": "#475569",
      "muted": "#64748b",
      "inverse": "#ffffff",
      "link": "#0f766e"
    },
    "border": {
      "subtle": "#e2e8f0",
      "default": "#cbd5e1",
      "strong": "#94a3b8",
      "focus": "#0f766e"
    },
    "action": {
      "primary": "#0f766e",
      "primaryHover": "#115e59",
      "secondary": "#334155",
      "disabled": "#cbd5e1"
    },
    "status": {
      "success": "#15803d",
      "successSurface": "#dcfce7",
      "warning": "#b45309",
      "warningSurface": "#fef3c7",
      "error": "#b91c1c",
      "errorSurface": "#fee2e2",
      "info": "#0369a1",
      "infoSurface": "#e0f2fe"
    }
  },
  "font": {
    "family": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, monospace"
    },
    "size": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.65
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(15, 23, 42, 0.08)",
    "md": "0 8px 24px rgba(15, 23, 42, 0.12)"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "motion": {
    "durationFast": "120ms",
    "durationNormal": "180ms",
    "durationSlow": "240ms",
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
